# Copy this file to .env and fill in your real keys
SECRET_KEY=change-me-to-a-long-random-string

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal (https://developer.paypal.com) - use live or sandbox URLs
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_MODE=live

# Paynow Zimbabwe (https://www.paynow.co.zw) - from your Paynow account
PAYNOW_INTEGRATION_ID=...
PAYNOW_INTEGRATION_KEY=...

# Email (optional - order confirmations)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=orders@llndn.g
